# Data artifacts (regenerated by `match-charting-project ingest`).
# Exception: data/draws/ holds committed draw-slot fixtures — tiny, static facts
# about each tournament's bracket that no CI-fetchable source provides.
/data/*
!/data/draws/
*.duckdb
*.duckdb.wal
*.parquet

# Generated report artifacts — regenerated by the experiments; keep the .md,
# not the CSV slices (large, noisy diffs). New figures are ignored by default
# (already-tracked ones are unaffected and stay); when a report earns a figure,
# bless it deliberately with `git add -f reports/figures/<name>.png`.
/reports/*.csv
/reports/figures/*

# Generated site data (brackets feed + insights db) — built by CI, served via Pages,
# never committed. Only the docs/ source (html/js/css) is tracked.
/docs/data/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# OS / editors / local tooling
.DS_Store
.vscode/
.idea/
.claude/
